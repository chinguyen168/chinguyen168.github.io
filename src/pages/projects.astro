---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
const description =
  'My work at Magnolia, this personal site, and earlier projects in banking and insurance.';
---

<BaseLayout title="Projects" description={description}>
  <PageHeader eyebrow="Built & explored" description={description}>
    Learning
    <br />
    <em>by building.</em>
  </PageHeader>
  <div class="workflow">
    <h2>How I build today</h2>
    <p>
      My current work centers on Magnolia. In my own daily development, Claude
      Code helps me take ideas from feature drafts and written specifications to
      working code. I guide the process, review the changes, and refine the
      result.
    </p>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => (
      <article class="project-card">
        <>
          <span class="number">
            {String(index + 1).padStart(2, '0')} / PROJECT
          </span>
          <h2>{project.name}</h2>
          <p class="context">{project.context}</p>
          <p class="description">{project.description}</p>
          <p class="meta">{project.technologies.join(' · ')}</p>
          {project.repo && (
            <a
              href={`${profile.github}/${project.repo}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              View repository ↗
            </a>
          )}
        </>
      </article>
    ))}
  </div>
</BaseLayout>
<style>
  .workflow {
    max-width: 650px;
    margin-top: 32px;
  }
  .workflow p {
    color: var(--muted);
  }
  .context {
    color: var(--muted);
    font-size: var(--text-small);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 32px;
  }
  .project-card {
    padding: 28px;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 6px;
  }
  .number {
    font: var(--text-label) var(--font-mono);
    color: var(--accent);
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 12px;
  }
  .project-card a {
    font-size: var(--text-small);
  }
  @media (max-width: 800px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
