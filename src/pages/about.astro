---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="About & experience" description={profile.description}>
  <PageHeader eyebrow="The person behind the code" description={profile.about}>
    Developer.
    <br />
    Team lead.
    <br />
    <em>Always learning.</em>
  </PageHeader>
  <div class="biography">
    {profile.biography.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <div class="section-top">
    <h2>Experience</h2>
  </div>
  <h3>
    {profile.experience.company}{' '}
    <span class="location">· {profile.experience.location}</span>
  </h3>
  {profile.experience.roles.map((experience) => (
    <section class="timeline">
      <>
        <span class="tag">{experience.period}</span>
        <h3>{experience.title}</h3>
        <p class="description">{experience.description}</p>
        {experience.responsibilities.length > 0 && (
          <ul class="description">
            {experience.responsibilities.map((responsibility) => (
              <li>{responsibility}</li>
            ))}
          </ul>
        )}
        {experience.workflow && (
          <p class="description">{experience.workflow}</p>
        )}
      </>
    </section>
  ))}
  <div class="section-top">
    <h2>Earlier chapters</h2>
  </div>
  {profile.earlierExperience.map((experience) => (
    <section class="timeline">
      <span class="tag">{experience.period}</span>
      <h3>{experience.title}</h3>
      <p class="company">{experience.company}</p>
      <p class="description">{experience.description}</p>
    </section>
  ))}
  <div class="section-top">
    <h2>Skills — what I work with</h2>
  </div>
  <dl class="skills">
    {profile.skills.map((skill) => (
      <div>
        <dt>{skill.title}</dt>
        <dd class="description">{skill.description}</dd>
      </div>
    ))}
  </dl>
  <div class="bottom-note">
    <span aria-hidden="true">↗</span>
    <p>
      Explore my work and open-source repositories on{' '}
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      .
    </p>
  </div>
</BaseLayout>
<style>
  .timeline {
    border-left: 1px solid var(--line);
    padding-left: 25px;
    margin: 35px 0;
  }
  .timeline h3 {
    font-size: 1.5rem;
  }
  .biography {
    max-width: 650px;
    color: var(--muted);
  }
  .location,
  .company {
    color: var(--muted);
    font-size: var(--text-control);
  }
  .timeline ul {
    padding-left: 20px;
  }
  .timeline li + li {
    margin-top: 6px;
  }
  .skills {
    margin: 0;
  }
  .skills > div {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 6px 0 0;
  }
</style>
