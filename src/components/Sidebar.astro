---
import { profile } from '../data/profile';
const links = [
  { href: '/', label: 'Home', icon: '⌂' },
  { href: '/about/', label: 'About & experience', icon: '◯' },
  { href: '/blog/', label: 'Blogs', icon: '▤' },
  { href: '/til/', label: 'Today I learned', icon: '✳' },
  { href: '/projects/', label: 'Projects', icon: '▧' },
];
const path = Astro.url.pathname;
---

<aside>
  <a class="brand" href="/">
    {profile.wordmark}
    <span>.dev</span>
  </a>
  <div class="identity">
    <strong>{profile.name}</strong>
    <span>{profile.role}</span>
  </div>
  <nav aria-label="Main navigation">
    {links.map(({ href, label, icon }) => {
      const active = href === '/' ? path === '/' : path.startsWith(href);
      return (
        <a
          href={href}
          class:list={{ active }}
          aria-current={active ? 'page' : undefined}
        >
          <>
            <span aria-hidden="true">{icon}</span>
            <span>{label}</span>
          </>
        </a>
      );
    })}
  </nav>
  <div class="aside-bottom">
    <p>
      A little corner of the internet.
      <br />
      Always a work in progress.
    </p>
    <div class="social-links">
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.22 3.28.93.1-.73.39-1.22.71-1.5-2.5-.28-5.12-1.25-5.12-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" />
        </svg>
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.89a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.86H15.8v-4.64c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.51V9.2h2.83v1.3h.04c.39-.75 1.36-1.55 2.79-1.55 2.98 0 3.58 1.96 3.58 4.51v5.29Z" />
        </svg>
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</aside>
<style>
  aside {
    padding: 45px 32px;
    border-right: 1px solid var(--line);
    background: var(--sidebar);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow-y: auto;
  }
  .brand {
    font: 400 21px/1.4 var(--font-mono);
    width: max-content;
  }
  .brand span {
    color: var(--accent);
  }
  .identity {
    margin: 28px 0 20px;
  }
  .identity strong,
  .identity span {
    display: block;
  }
  .identity strong {
    font-weight: 600;
  }
  .identity span {
    font-size: var(--text-small);
    color: var(--muted);
    margin-top: 4px;
  }
  nav {
    display: grid;
    gap: 6px;
  }
  nav a {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 9px 11px;
    margin-left: -12px;
    font-size: var(--text-control);
    color: var(--muted);
    border: 1px solid transparent;
    border-radius: 4px;
  }
  nav a.active {
    background: var(--panel);
    color: var(--accent);
    border-color: var(--line);
  }
  nav a.active::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    margin-left: auto;
  }
  .aside-bottom {
    margin-top: auto;
    padding-top: 35px;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .aside-bottom p {
    line-height: 1.8;
  }
  .aside-bottom a {
    color: var(--ink);
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
  }
  .social-links a:hover {
    color: var(--accent);
  }
  .social-links svg {
    flex-shrink: 0;
  }
  @media (max-width: 1100px) {
    aside {
      padding-inline: 25px 22px;
    }
  }
  @media (max-width: 800px) {
    aside {
      position: relative;
      height: auto;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 18px 24px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      align-items: center;
    }
    .brand {
      font-size: 1.375rem;
      grid-column: 1 / -1;
    }
    .identity {
      grid-column: 1 / -1;
      margin: 0;
    }
    .identity strong {
      font-size: var(--text-control);
    }
    .identity span {
      font-size: var(--text-small);
    }
    nav {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }
    nav a {
      margin: 0;
      padding: 8px;
      font-size: 0.9375rem;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    nav a.active::after {
      display: none;
    }
    .aside-bottom {
      grid-column: 1 / -1;
      padding-top: 0;
      margin-top: 0;
    }
    .aside-bottom p {
      display: none;
    }
  }
</style>
